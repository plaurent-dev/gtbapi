NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Modbus target (leave empty to force host in request)
MODBUS_HOST=
MODBUS_PORT=4196
MODBUS_UNIT_ID=91
MODBUS_TIMEOUT_MS=2000

# Polling (0 disables background polling)
POLL_INTERVAL_MS=0

# Discovery defaults
DEFAULT_SUBNET=192.168.1
DISCOVERY_FROM=1
DISCOVERY_TO=254
DISCOVERY_PORT=4196
DISCOVERY_TIMEOUT_MS=700
DISCOVERY_CONCURRENCY=40

# Optional MQTT publishing
MQTT_ENABLED=false
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_TOPIC=modbus/mesures

# Optional GELF publishing (Graylog UDP)
GELF_ENABLED=false
GELF_HOST=127.0.0.1
GELF_PORT=12201
