NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Shared PostgreSQL connection. Profile inventory uses a separate read-only pool.
# Leave PGUSER empty to disable gateway lists and measurement ingestion.
PGHOST=10.62.20.49
PGPORT=5432
PGDATABASE=gtb_db
PGUSER=
PGPASSWORD=

# Required Bearer key for POST /api/v1/meter/measurements (at least 32 characters).
# Leave empty to disable ingestion. The write pool also requires INSERT privileges.
MEASUREMENTS_API_KEY=

# Modbus target (leave empty to force host in request)
MODBUS_HOST=
MODBUS_PORT=4196
MODBUS_UNIT_ID=91
MODBUS_TIMEOUT_MS=2000

# Polling (0 disables background polling)
POLL_INTERVAL_MS=0

# Discovery defaults
DEFAULT_SUBNET=192.168.1
DISCOVERY_FROM=1
DISCOVERY_TO=254
DISCOVERY_PORT=4196
DISCOVERY_TIMEOUT_MS=700
DISCOVERY_CONCURRENCY=40

# Optional MQTT publishing
MQTT_ENABLED=false
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_TOPIC=modbus/mesures

# Optional ChirpStack LoRaWAN collector; independent of the Modbus publisher.
# Apply portailgtb/database/012_lorawan.sql and grant database privileges first.
LORAWAN_ENABLED=false
LORAWAN_TENANT_ID=
LORAWAN_API_SERVER=127.0.0.1:8080
LORAWAN_API_TOKEN=
# Keep TLS enabled for remote servers; false sends the API token without encryption.
LORAWAN_API_TLS=true
LORAWAN_MQTT_URL=mqtt://127.0.0.1:1883
LORAWAN_MQTT_USERNAME=
LORAWAN_MQTT_PASSWORD=
# Stable, unique broker client ID. Empty derives one from the tenant ID.
LORAWAN_MQTT_CLIENT_ID=
LORAWAN_SYNC_INTERVAL_MS=60000
# Optional LDS02 profile UUIDs for field validation and historical V/min units only.
# No local payload decoding. Profiles named LDS02 or Dragino-LDS02 need no UUID.
LORAWAN_LDS02_PROFILE_IDS=

# Optional GELF publishing (Graylog UDP)
GELF_ENABLED=false
GELF_HOST=127.0.0.1
GELF_PORT=12201
